<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Smooth Gradient Background -->
    <gradient
        android:startColor="#FFFFFF"
        android:endColor="#E3F2FD"
        android:angle="90"/>

    <!-- Rounded Corners -->
    <corners android:radius="18dp" />

    <!-- Soft Border -->
    <stroke
        android:width="1dp"
        android:color="#B0BEC5"/>

    <!-- Inner Padding -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>
</shape>
