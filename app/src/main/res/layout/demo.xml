<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍽️ Post New Meal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Date"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSelectDateDialog"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="📅 Select Date"
        android:textSize="14sp"
        android:background="@drawable/button_outline"
        android:textColor="#2196F3"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSelectedDateDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No date selected"
        android:textSize="12sp"
        android:textColor="#999999"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meal Type"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgMealTypeDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/rbLunchDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🥗 Lunch"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbDinnerDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🍲 Dinner"
            android:textSize="13sp" />

    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meal Items"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etMealItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter meal item"
        android:inputType="text"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/edittext_background"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnAddItemDialog"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="➕ Add Meal Item"
        android:textSize="13sp"
        android:background="@drawable/button_outline_green"
        android:textColor="#388E3C"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/llMealItemsContainerDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSubmitMeal"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="🚀 Post Meal"
        android:textSize="15sp"
        android:background="@drawable/button_gradient_green"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>