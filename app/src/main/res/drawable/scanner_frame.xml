<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Corners -->
    <item android:top="0dp" android:left="0dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="40dp" />
            <stroke android:width="8dp" android:color="#FF4081" />
        </shape>
    </item>

    <item android:top="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="40dp" />
            <stroke android:width="8dp" android:color="#FF4081" />
        </shape>
    </item>

    <item android:bottom="0dp" android:left="0dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="40dp" />
            <stroke android:width="8dp" android:color="#FF4081" />
        </shape>
    </item>

    <item android:bottom="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="40dp" />
            <stroke android:width="8dp" android:color="#FF4081" />
        </shape>
    </item>
</layer-list>