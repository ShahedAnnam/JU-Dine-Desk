<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview View for CameraX -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Overlay with scanning area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#80000000">

        <!-- Scanning Frame -->
        <FrameLayout
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/scanner_frame">

            <View
                android:id="@+id/scannerLine"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="#FF4081"
                android:layout_gravity="center_vertical" />

        </FrameLayout>

        <!-- Instructions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position QR code inside the frame"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="20dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The QR code will be scanned automatically"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Flash Toggle Button -->
    <ImageView
        android:id="@+id/btnFlash"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_flash_off"
        android:background="@drawable/circle_button"
        android:padding="12dp"
        app:tint="#FFFFFF"
        android:contentDescription="Toggle Flash" />

    <!-- Close Button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/circle_button"
        android:padding="12dp"
        app:tint="#FFFFFF"
        android:contentDescription="Close Scanner" />

    <!-- Manual Input Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnManualInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:text="Enter QR Code Manually"
        android:textSize="14sp"
        app:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:cornerRadius="20dp"
        android:paddingHorizontal="20dp" />

</RelativeLayout>