<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F2F4F7">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Hall Name -->
        <TextView
            android:id="@+id/tvHallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hall Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="12dp"/>

        <!-- Date Row -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Date"
                android:background="@drawable/btn_secondary"
                android:textColor="#ffffff"/>
        </LinearLayout>

        <!-- LUNCH CARD -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/lunch_card_bg"
            android:padding="18dp"
            android:elevation="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Lunch"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLunchItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Not posted yet"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLunchPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textSize="16sp"
                android:textColor="#004D40"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBuyLunch"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:text="Buy Lunch Coupon"
                android:textSize="16sp"
                android:background="@drawable/btn_green"
                android:textColor="#ffffff"/>
        </LinearLayout>

        <!-- DINNER CARD -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:background="@drawable/dinner_card_bg"
            android:padding="18dp"
            android:elevation="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Dinner"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvDinnerItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Not posted yet"
                android:textColor="#333333"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDinnerPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="#311B92"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBuyDinner"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:text="Buy Dinner Coupon"
                android:textSize="16sp"
                android:background="@drawable/btn_purple"
                android:textColor="#ffffff"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
